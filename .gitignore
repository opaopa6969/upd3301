node_modules/
roms/*
!roms/README.md

# blargg's Game Boy test ROMs. Everything else in gbroms/ is committed because
# it is MIT-licensed and redistributable; blargg's carry no licence at all, so
# they are fetched on demand (node gbtools/fetch-blargg.mjs) and never
# committed. The tests that use them skip when they are absent.
gbroms/blargg/
hw/gerber/

# opn-scope demo performance data — large generated OPN register traces + audio
# (feena/ys2/sor). Kept out of git (~27 MB); distributed to prod/dev by other
# means (scp from HVU). opn-scope.html degrades gracefully when they're absent.
demo/*-trace.json
demo/*-regs.json
demo/*.mp3

# per-user ROM/disk library written by serve.py /api/store (user dumps; never in git)
userdata/

# scratch ROM images the browser smoke test hands to the page's file inputs
# (tools/smoke.mjs deletes them on a clean exit; this covers an interrupted run).
# The screenshots and report.json next to it ARE committed — they are the evidence.
docs/smoke-shots/.tmp/

# SingleStepTests 68000 vectors, fetched by m68ktools/fetch-tests.sh (~138 MB).
# Reference data, regenerated upstream — never committed.
m68k-tests/
